<?xml version="1.0" encoding="utf-8"?>
<!--
    Default views of the DnsLathund object types (CONTRACTS.md section 14).
    Only table and list views: a DefaultDisplayPropertySet would need a types file
    with a PSPropertySet, which Constrained Language Mode blocks.
    Time spans are shown as d.hh:mm:ss (or hh:mm:ss under one day), without the
    fractional seconds of the default TimeSpan text.
-->
<Configuration>
    <ViewDefinitions>
        <View>
            <Name>DnsLathund.Entry</Name>
            <ViewSelectedBy>
                <TypeName>DnsLathund.Entry</TypeName>
            </ViewSelectedBy>
            <TableControl>
                <TableHeaders>
                    <TableColumnHeader>
                        <Label>Name</Label>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>Type</Label>
                        <Width>5</Width>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>Data</Label>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>TTL</Label>
                        <Width>7</Width>
                        <Alignment>Right</Alignment>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>PtrStatus</Label>
                        <Width>13</Width>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>Zone</Label>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>Source</Label>
                        <Width>8</Width>
                    </TableColumnHeader>
                </TableHeaders>
                <TableRowEntries>
                    <TableRowEntry>
                        <TableColumnItems>
                            <TableColumnItem>
                                <PropertyName>Name</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>Type</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>Data</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>TTL</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>PtrStatus</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>Zone</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>Source</PropertyName>
                            </TableColumnItem>
                        </TableColumnItems>
                    </TableRowEntry>
                </TableRowEntries>
            </TableControl>
        </View>
        <View>
            <Name>DnsLathund.Entry.List</Name>
            <ViewSelectedBy>
                <TypeName>DnsLathund.Entry</TypeName>
            </ViewSelectedBy>
            <ListControl>
                <ListEntries>
                    <ListEntry>
                        <ListItems>
                            <ListItem>
                                <PropertyName>Name</PropertyName>
                            </ListItem>
                            <ListItem>
                                <PropertyName>Type</PropertyName>
                            </ListItem>
                            <ListItem>
                                <PropertyName>Data</PropertyName>
                            </ListItem>
                            <ListItem>
                                <PropertyName>TTL</PropertyName>
                            </ListItem>
                            <ListItem>
                                <PropertyName>PtrStatus</PropertyName>
                            </ListItem>
                            <ListItem>
                                <PropertyName>Zone</PropertyName>
                            </ListItem>
                            <ListItem>
                                <PropertyName>NodeName</PropertyName>
                            </ListItem>
                            <ListItem>
                                <PropertyName>Timestamp</PropertyName>
                            </ListItem>
                            <ListItem>
                                <PropertyName>IsStatic</PropertyName>
                            </ListItem>
                            <ListItem>
                                <PropertyName>HasDhcid</PropertyName>
                            </ListItem>
                            <ListItem>
                                <PropertyName>InDhcpRange</PropertyName>
                            </ListItem>
                            <ListItem>
                                <PropertyName>ReverseZone</PropertyName>
                            </ListItem>
                            <ListItem>
                                <PropertyName>PtrTargets</PropertyName>
                            </ListItem>
                            <ListItem>
                                <PropertyName>PtrZoneFound</PropertyName>
                            </ListItem>
                            <ListItem>
                                <PropertyName>SharedWith</PropertyName>
                            </ListItem>
                            <ListItem>
                                <PropertyName>Aliases</PropertyName>
                            </ListItem>
                            <ListItem>
                                <PropertyName>ReferencedBy</PropertyName>
                            </ListItem>
                            <ListItem>
                                <PropertyName>Target</PropertyName>
                            </ListItem>
                            <ListItem>
                                <PropertyName>TargetExists</PropertyName>
                            </ListItem>
                            <ListItem>
                                <PropertyName>DistinguishedName</PropertyName>
                            </ListItem>
                            <ListItem>
                                <PropertyName>Owner</PropertyName>
                            </ListItem>
                            <ListItem>
                                <PropertyName>Server</PropertyName>
                            </ListItem>
                            <ListItem>
                                <PropertyName>Source</PropertyName>
                            </ListItem>
                            <ListItem>
                                <Label>SnapshotAge</Label>
                                <ScriptBlock>
                                    $age = $_.SnapshotAge
                                    if ($null -eq $age) { '' }
                                    elseif ($age.Ticks -lt 0) { [string]$age }
                                    elseif ($age.Days -gt 0) { $age.ToString('d\.hh\:mm\:ss') }
                                    else { $age.ToString('hh\:mm\:ss') }
                                </ScriptBlock>
                            </ListItem>
                        </ListItems>
                    </ListEntry>
                </ListEntries>
            </ListControl>
        </View>
        <View>
            <Name>DnsLathund.Snapshot</Name>
            <ViewSelectedBy>
                <TypeName>DnsLathund.Snapshot</TypeName>
            </ViewSelectedBy>
            <TableControl>
                <TableHeaders>
                    <TableColumnHeader>
                        <Label>Server</Label>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>Zone</Label>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>ExportedAt</Label>
                        <Width>20</Width>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>Age</Label>
                        <Width>12</Width>
                        <Alignment>Right</Alignment>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>ZoneType</Label>
                        <Width>9</Width>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>IsReverse</Label>
                        <Width>9</Width>
                    </TableColumnHeader>
                </TableHeaders>
                <TableRowEntries>
                    <TableRowEntry>
                        <TableColumnItems>
                            <TableColumnItem>
                                <PropertyName>Server</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>Zone</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>ExportedAt</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <ScriptBlock>
                                    $age = $_.Age
                                    if ($null -eq $age) { '' }
                                    elseif ($age.Ticks -lt 0) { [string]$age }
                                    elseif ($age.Days -gt 0) { $age.ToString('d\.hh\:mm\:ss') }
                                    else { $age.ToString('hh\:mm\:ss') }
                                </ScriptBlock>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>ZoneType</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>IsReverse</PropertyName>
                            </TableColumnItem>
                        </TableColumnItems>
                    </TableRowEntry>
                </TableRowEntries>
            </TableControl>
        </View>
        <View>
            <Name>DnsLathund.Result</Name>
            <ViewSelectedBy>
                <TypeName>DnsLathund.Result</TypeName>
            </ViewSelectedBy>
            <TableControl>
                <TableHeaders>
                    <TableColumnHeader>
                        <Label>Action</Label>
                        <Width>13</Width>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>Name</Label>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>Data</Label>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>Result</Label>
                        <Width>11</Width>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>Error</Label>
                    </TableColumnHeader>
                </TableHeaders>
                <TableRowEntries>
                    <TableRowEntry>
                        <TableColumnItems>
                            <TableColumnItem>
                                <PropertyName>Action</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>Name</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>Data</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>Result</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>Error</PropertyName>
                            </TableColumnItem>
                        </TableColumnItems>
                    </TableRowEntry>
                </TableRowEntries>
            </TableControl>
        </View>
        <View>
            <Name>DnsLathund.ZoneInfo</Name>
            <ViewSelectedBy>
                <TypeName>DnsLathund.ZoneInfo</TypeName>
            </ViewSelectedBy>
            <TableControl>
                <TableHeaders>
                    <TableColumnHeader>
                        <Label>ZoneName</Label>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>ZoneType</Label>
                        <Width>9</Width>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>IsReverse</Label>
                        <Width>9</Width>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>ReplicationScope</Label>
                        <Width>16</Width>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>DynamicUpdate</Label>
                        <Width>18</Width>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>AgingEnabled</Label>
                        <Width>12</Width>
                    </TableColumnHeader>
                </TableHeaders>
                <TableRowEntries>
                    <TableRowEntry>
                        <TableColumnItems>
                            <TableColumnItem>
                                <PropertyName>ZoneName</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>ZoneType</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>IsReverse</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>ReplicationScope</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>DynamicUpdate</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>AgingEnabled</PropertyName>
                            </TableColumnItem>
                        </TableColumnItems>
                    </TableRowEntry>
                </TableRowEntries>
            </TableControl>
        </View>
    </ViewDefinitions>
</Configuration>
